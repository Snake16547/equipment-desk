# Change both values before first start.
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters-ideally-64
APP_TITLE=Equipment Desk

# Keep true when served through HTTPS. Set false only for local HTTP testing.
COOKIE_SECURE=true

# Optional: set to your published Docker Hub image.
# EQUIPMENT_DESK_IMAGE=YOUR_DOCKERHUB_USERNAME/equipment-desk:0.2.0
